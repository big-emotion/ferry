{
  "name": "ferry",
  "version": "0.0.1",
  "description": "Ferry — GitHub Actions–native agent pipeline for Jira-driven automated development",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/genai": "^1.0.0",
    "@octokit/rest": "^21.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.1",
    "openai": "^4.0.0",
    "ulid": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
